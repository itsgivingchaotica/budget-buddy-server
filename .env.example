# Copy to .env and fill in values. Never commit .env.

# --- Currently present in .env ---
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_REDIRECT_URI=
KINDE_SITE=

# --- Read by Kinde::TokenVerifier.from_env (S1a; not yet wired into controllers) ---
# https origin of your Kinde domain, e.g. https://yourapp.kinde.com
KINDE_ISSUER_URL=
# Kinde API audience; becomes REQUIRED when controller auth is enabled (S1b, after task KA)
KINDE_AUDIENCE=

# --- Planned (see docs/IMPLEMENTATION_PLAN.md); not read by the app yet ---
# CORS_ORIGINS=
# ANTHROPIC_API_KEY=
ANTHROPIC_CATEGORIZATION_MODEL=claude-haiku-5-5
ANTHROPIC_ASSISTANT_MODEL=claude-haiku-5-5
